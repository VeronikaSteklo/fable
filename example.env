# Required connection settings. Fill these for your LLM provider.
# Docker: use http://host.docker.internal:PORT/v1 instead of localhost for a host LLM.
# The same applies to EMBEDDING_BASE_URL when embeddings run on the host.
BASE_URL=
API_KEY=
MODEL=

# Optional settings. These also have defaults in Settings.
ENABLE_THINKING=none
TEMPERATURE=0.7
# SDK transport (also used for embeddings):
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=2
# Tool execution rounds per turn, then a final tool_choice=none completion:
# MAX_TOOL_ROUNDS=8
# json_schema | json_object | prompt; unsupported formats fall back in that order.
# STRUCTURED_OUTPUT=json_schema
EMBEDDING_MODEL=
# Optional if embeddings use a different OpenAI-compatible endpoint:
# EMBEDDING_BASE_URL=
# MEMORY_STORE_PATH=.fable/chroma
# MEMORY_SEARCH_LIMIT=3

# Optional overrides:
# HISTORY_LIMIT=16
# DEFAULT_WORLD=Фэнтезийный мир, в котором древняя магия постепенно возвращается.
# DEFAULT_STORY=Герой оказывается перед загадкой, которая может изменить его жизнь.
# DEFAULT_CHARACTER_NAME=Безымянный герой
# DEFAULT_CHARACTER_ROLE=странник
# DEFAULT_CHARACTER_GOAL=раскрыть тайну
# DEFAULT_GENRE=фэнтези
# Модерация ввода игрока (LLM-классификатор поверх правил)
MODERATION_ENABLED=true
# MODERATION_MODEL=

# Сжатие истории и проверка согласованности (по умолчанию используется MODEL)
# SUMMARY_ENABLED=true
# SUMMARY_MAX_CHARS=2000
# SUMMARY_MODEL=
# CONSISTENCY_CHECK_ENABLED=true
# CONSISTENCY_MODEL=
# SESSIONS_PATH=.fable/sessions

# Спутники: отдельные LLM-роли (каждый ask_companion — дополнительный запрос)
# При false профили и состояние сохраняются, спутников озвучивает мастер без tools.
# COMPANIONS_ENABLED=true
# COMPANION_MODEL=
# COMPANION_TEMPERATURE=0.8

# Авторизация веб-интерфейса (CLI не требует входа)
# AUTH_DB_PATH=.fable/fable.db
# SESSION_TTL_DAYS=30
# COOKIE_SECURE=false
# ALLOW_REGISTRATION=true

# Optional server storage/coordination (unset = JSON + SQLite + memory).
# DATABASE_URL=postgresql://fable:fable@localhost:5432/fable
# REDIS_URL=redis://localhost:6379/0
# DB_POOL_MIN=1
# DB_POOL_MAX=10
# TURN_LOCK_TTL_SECONDS=600
# More than one HTTP worker requires BOTH URLs:
# FABLE_WORKERS=2
# Compose development credentials (replace for deployment and match DATABASE_URL):
# POSTGRES_DB=fable
# POSTGRES_USER=fable
# POSTGRES_PASSWORD=fable
