# Required connection settings. Fill these for your LLM provider.
BASE_URL=
API_KEY=
MODEL=

# Optional settings. These also have defaults in Settings.
ENABLE_THINKING=none
TEMPERATURE=0.7
EMBEDDING_MODEL=
# Optional if embeddings use a different OpenAI-compatible endpoint:
# EMBEDDING_BASE_URL=
# MEMORY_STORE_PATH=.fable/chroma
# MEMORY_SEARCH_LIMIT=3

# Optional overrides:
# HISTORY_LIMIT=16
# DEFAULT_WORLD=Фэнтезийный мир, в котором древняя магия постепенно возвращается.
# DEFAULT_STORY=Герой оказывается перед загадкой, которая может изменить его жизнь.
# DEFAULT_CHARACTER_NAME=Безымянный герой
# DEFAULT_CHARACTER_ROLE=странник
# DEFAULT_CHARACTER_GOAL=раскрыть тайну
# DEFAULT_GENRE=фэнтези
# Модерация ввода игрока (LLM-классификатор поверх правил)
MODERATION_ENABLED=true
# MODERATION_MODEL=
